node_modules/
.DS_Store
*.log

# Claude Code working state, plus whatever `npx skills add` installs here. Running
# this repo's own skills on this repo re-downloads them from GitHub into .agents/,
# symlinks them into .claude/skills/, and records the install in skills-lock.json.
# All three are one consumer-side artefact: committing them would vendor a second,
# stale copy of skills/<name>/ back into the repo that publishes it.
.claude/
.agents/
skills-lock.json

# Doc-visual render byproducts — the committed artefacts are the .webp files
# in docs/assets/ plus each composition's index.html and viz.json
docs/assets/src/**/render.mp4
docs/assets/src/**/renders/
docs/assets/src/**/frames/
docs/assets/src/**/snapshots/
docs/assets/src/**/qa_*.png
docs/assets/src/**/check.json
docs/assets/src/**/node_modules/

# pretty-svg-docs authors SVG directly, so the asset is its own source; only the
# scrub harness and its screenshots are byproducts
docs/assets/src/**/_qa/

# browser-automation byproducts from the visual QA pass
.playwright-mcp/

__pycache__/
